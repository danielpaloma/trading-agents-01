# .env.example - Trading Agents Configuration Template
# Copy to .env and fill in your API keys

# ============================================================
# LLM/Model Configuration
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Model assignments per agent (OpenRouter model IDs)
# Tip: Use lighter models for market_data, execution, monitor
MODEL_ORCHESTRATOR=anthropic/claude-sonnet-4-6
MODEL_MARKET_DATA=anthropic/claude-haiku-4-5
MODEL_ANALYSIS=anthropic/claude-sonnet-4-6
MODEL_STRATEGY=anthropic/claude-sonnet-4-6
MODEL_RISK=anthropic/claude-sonnet-4-6
MODEL_EXECUTION=anthropic/claude-haiku-4-5
MODEL_MONITOR=anthropic/claude-haiku-4-5

# ============================================================
# IBKR Connection Configuration
# ============================================================
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ============================================================
# Instrument Configuration
# ============================================================
# Type: STOCK, FOREX, or CFD
INSTRUMENT_TYPE=FOREX

# Symbol varies by instrument type:
#   FOREX: EURUSD, GBPUSD, USDJPY, etc.
#   STOCK: AAPL, MSFT, TSLA, etc.
#   CFD: EUR, GBP, etc. (currency indices)
SYMBOL=EURUSD
EXCHANGE=IDEALPRO
CURRENCY=USD

# ============================================================
# Trading Session Configuration
# ============================================================
BAR_SIZE=1 min
SESSION_DURATION_HOURS=0.01666  # ~1 minute for testing
MAX_POSITION_UNITS=10

# ============================================================
# Risk/Money Management Configuration
# ============================================================
STOP_LOSS_PCT=0.005      # 0.5%
TAKE_PROFIT_PCT=0.010   # 1.0%
MAX_DRAWDOWN_PCT=0.02   # 2%
INITIAL_CAPITAL=1000